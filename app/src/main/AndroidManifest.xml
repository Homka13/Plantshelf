<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".PlantshelfApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Plantshelf">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.PlantDetailActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.LightMeterActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.AddEditPlantActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.CareCalendarActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.PlantCatalogActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <!-- FileProvider for Camera photos and APK updates -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Desktop Care AppWidget (Scrollable List 4x3): exported="true" required for OS AppWidget host broadcasts -->
        <receiver
            android:name=".widget.PlantCareWidgetProvider"
            android:exported="true"
            android:label="@string/widget_care_list_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.plantshelf.app.widget.ACTION_REFRESH_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/plant_care_widget_info" />
        </receiver>

        <!-- Garden Status AppWidget (Compact 2x1 / 2x2): exported="true" -->
        <receiver
            android:name=".widget.PlantStatusWidgetProvider"
            android:exported="true"
            android:label="@string/widget_status_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.plantshelf.app.widget.ACTION_REFRESH_STATUS_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/plant_status_widget_info" />
        </receiver>

        <!-- Quick Water AppWidget (Urgent Plant & 1-tap Water 3x2): exported="true" -->
        <receiver
            android:name=".widget.QuickWaterWidgetProvider"
            android:exported="true"
            android:label="@string/widget_quick_water_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.plantshelf.app.widget.ACTION_REFRESH_QUICK_WIDGET" />
                <action android:name="com.plantshelf.app.widget.ACTION_QUICK_WATER_NOW" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_water_widget_info" />
        </receiver>

        <!-- Shortcuts AppWidget (Launcher Bar 4x1): exported="true" -->
        <receiver
            android:name=".widget.PlantShortcutsWidgetProvider"
            android:exported="true"
            android:label="@string/widget_shortcuts_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/plant_shortcuts_widget_info" />
        </receiver>

        <!-- RemoteViews factory service: internal component, exported="false" -->
        <service
            android:name=".widget.PlantCareWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

    </application>

</manifest>
