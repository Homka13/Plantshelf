<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widgetStatusRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header Row -->
    <LinearLayout
        android:id="@+id/widgetStatusHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_water"
            android:tint="#2D6A4F"
            tools:ignore="UseAppTint" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Plantshelf"
            android:textColor="#1B4332"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnStatusRefresh"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Оновити"
            android:padding="4dp"
            android:src="@drawable/ic_sync"
            android:tint="#2D6A4F"
            tools:ignore="UseAppTint" />
    </LinearLayout>

    <!-- Stat Badges Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Water Stat -->
        <LinearLayout
            android:id="@+id/cardWaterStat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_water_badge"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_water"
                android:tint="#3A86C8"
                tools:ignore="UseAppTint" />

            <TextView
                android:id="@+id/tvStatusWaterCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="0"
                android:textColor="#1E3A8A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Полив"
                android:textColor="#2563EB"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Fert Stat -->
        <LinearLayout
            android:id="@+id/cardFertStat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_fert_badge"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_fert"
                android:tint="#E76F51"
                tools:ignore="UseAppTint" />

            <TextView
                android:id="@+id/tvStatusFertCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="0"
                android:textColor="#9C4221"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Добрива"
                android:textColor="#D97706"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Urgent / Attention Stat -->
        <LinearLayout
            android:id="@+id/cardUrgentStat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_urgent_badge"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_quarantine"
                android:tint="#E63946"
                tools:ignore="UseAppTint" />

            <TextView
                android:id="@+id/tvStatusUrgentCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="0"
                android:textColor="#991B1B"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Увага"
                android:textColor="#DC2626"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Footer Summary Text -->
    <TextView
        android:id="@+id/tvStatusSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="Завантаження..."
        android:textColor="#52796F"
        android:textSize="11sp" />

</LinearLayout>
